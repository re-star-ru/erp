{
  "name": "site",
  "version": "1.0.0",
  "scripts": {
    "dev": "run-p hugo tailwind",
    "hugo": "hugo server -D --bind=0.0.0.0",
    "tailwind": "npx tailwindcss -i ./src/main.css -o ./assets/css/main.css --watch",
    "css-build": "npx tailwindcss -i ./src/main.css -o ./assets/css/main.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.4.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.6",
    "postcss-cli": "^9.1.0",
    "tailwindcss": "^3.0.22"
  }
}
